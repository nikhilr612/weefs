' ─── io.wfs.core.extractor ───────────────────────────────────────────────────
package "io.wfs.core.extractor" {

  interface ArchiveFormat {
    +supports(Path) : boolean
    +extract(Path, Path) : void
    +write(Path, Path) : void
  }

  enum ArchiveContainerType {
    ZIP
    TAR
    SINGLE_FILE
  }

  class ArchiveFormatInfo {
    -containerType : ArchiveContainerType
    -compressionKey : String
    ~containerType() : ArchiveContainerType
    ~compressionKey() : String
  }

  class ArchiveFormatDetector {
    ~{static} detect(Path) : ArchiveFormatInfo
  }

  class ArchiveFormats {
    +{static} resolve(Path) : ArchiveFormat
    +{static} extractToDirectory(Path, Path) : void
    +{static} writeFromDirectory(Path, Path) : void
  }

  class TarArchiveFormat {
    +supports(Path) : boolean
    +extract(Path, Path) : void
    +write(Path, Path) : void
  }

  class ZipArchiveFormat {
    +supports(Path) : boolean
    +extract(Path, Path) : void
    +write(Path, Path) : void
  }

  class ExtZipFsProvider {
    -mounted : Map<Path, ExtZipFileSystem>
    +getScheme() : String
    +newFileSystem(URI, Map) : FileSystem
  }

  class ExtZipFileSystem {
    -provider : ExtZipFsProvider
    -archivePath : Path
    -tempRoot : Path
    -readOnly : boolean
    -open : AtomicBoolean
    -shutdownHook : Thread
    ~installShutdownHook() : void
    ~getArchivePath() : Path
    ~getTempRoot() : Path
    ~wrap(Path) : ExtZipPath
    ~ensureWritable() : void
  }

  class ExtZipPath {
    -fileSystem : ExtZipFileSystem
    -delegate : Path
    ~getExtZipFileSystem() : ExtZipFileSystem
    ~getDelegate() : Path
  }

  class ExtZipParsedUri {
    -archivePart : String
    -entryPart : String
    ~archivePart() : String
    ~entryPart() : String
    ~{static} parse(URI, String) : ExtZipParsedUri
  }

  class ExtZipFsIO {
    ~{static} extractArchiveToDirectory(Path, Path) : void
    ~{static} extractZipToDirectory(Path, Path) : void
    ~{static} extractTarToDirectory(Path, Path, String) : void
    ~{static} writeDirectoryToZip(Path, Path) : void
    ~{static} writeDirectoryToTar(Path, Path, String) : void
  }

  class ExtZipDirectoryStream {
    -entries : List<Path>
    -filter : Filter
    -open : boolean
    +iterator() : Iterator<Path>
    +close() : void
  }

  class ExtZipDirectoryIterator {
    -inner : Iterator<Path>
    -filter : Filter
    -next : Path
  }

  class ExtZipPathIterator {
    -root : Path
  }
}

' ─── io.wfs.core.extractor.compression ──────────────────────────────────────
package "io.wfs.core.extractor.compression" {

  interface ICompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class CompressionStrategyFactory {
    +{static} forKey(String) : ICompressionStrategy
  }

  class GzipCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class Bzip2CompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class XzCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class LzmaCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class NoCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }
}

' ─── io.wfs.core.filesystem ──────────────────────────────────────────────────
package "io.wfs.core.filesystem" {

  interface FileSystemDriver <<GOOD>> {
    +scheme() : String
    +open(URI, Map) : FileSystem
  }

  class FileSystemFactory {
    -drivers : ConcurrentMap<String, FileSystemDriver>
    +register(FileSystemDriver) : void
    +registerDriver(String, FileSystemDriver) : void
    +open(URI, Map) : FileSystem
    +supportedSchemes() : List<String>
  }

  class FsEnvKeys {
    +{static} READ_ONLY : String
  }

  class LocalFileSystemDriver <<GOOD>> {
    ~scheme() : String
    ~open(URI, Map) : FileSystem
  }

  class NfsFileSystemDriver <<GOOD>> {
    -provider : NfsSftpFsProvider
    ~scheme() : String
    ~open(URI, Map) : FileSystem
  }

  class ZipFileSystemDriver <<GOOD>> {
    -provider : ExtZipFsProvider
    ~scheme() : String
    ~open(URI, Map) : FileSystem
  }
}

' ─── io.wfs.core.nfs ─────────────────────────────────────────────────────────
package "io.wfs.core.nfs" {

  interface IRemoteFileSystem {
    ~sftpConfig() : NfsSftpConfig
    ~hasSftpConfig() : boolean
    ~toRemotePath(NfsPath) : String
    ~ensureWritable() : void
    ~ensureWritableFor(Set) : void
    ~ensureOpen() : void
    ~fileSystem() : FileSystem
  }

  class NfsConnectionConfig {
    -host : String
    -port : int
    -exportPath : String
    -mountPath : String
    -timeoutSeconds : int
    -readOnly : boolean
    +getHost() : String
    +getPort() : int
    +getExportPath() : String
    +getMountPath() : String
    +getTimeoutSeconds() : int
    +isReadOnly() : boolean
  }

  class NfsFileInfo {
    -name : String
    -fullPath : String
    -directory : boolean
    -size : long
    -lastModified : long
    +getName() : String
    +getFullPath() : String
    +isDirectory() : boolean
    +getSize() : long
    +getLastModified() : long
    +getExtension() : String
  }

  class NfsFileSystem {
    -sftpProvider : NfsSftpFsProvider
    -config : NfsSftpConfig
    -legacyConfig : NfsConnectionConfig
    -readOnly : boolean
    -open : AtomicBoolean
    -shutdownHook : Thread
    ~sftpConfig() : NfsSftpConfig
    ~hasSftpConfig() : boolean
    ~config() : NfsSftpConfig
    ~getConfig() : NfsConnectionConfig
    ~installShutdownHook() : void
    ~fileSystem() : FileSystem
  }

  class NfsFsProvider {
    -{static} SCHEME : String
    -mounted : Map<String, NfsFileSystem>
    +getScheme() : String
    +newFileSystem(URI, Map) : FileSystem
  }

  class NfsIO {
    +{static} verifyConnection(NfsConnectionConfig) : void
    +{static} listDirectory(NfsConnectionConfig, String) : List<NfsFileInfo>
    +{static} readFile(NfsConnectionConfig, String) : byte[]
    +{static} writeFile(NfsConnectionConfig, String, byte[]) : void
    +{static} delete(NfsConnectionConfig, String) : void
    +{static} rename(NfsConnectionConfig, String, String) : void
    +{static} createDirectory(NfsConnectionConfig, String) : void
    +{static} copy(NfsConnectionConfig, String, String) : void
  }

  class NfsParsedUri {
    -host : String
    -port : int
    -remotePath : String
    -authEnvVar : String
    -username : String
    ~host() : String
    ~port() : int
    ~remotePath() : String
    ~authEnvVar() : String
    ~username() : String
    ~{static} parse(URI, String) : NfsParsedUri
  }

  class NfsPath {
    -fileSystem : NfsFileSystem
    -virtualPath : String
    -delegate : Path
    ~getNfsFileSystem() : NfsFileSystem
    ~virtualPath() : String
  }

  class NfsSftpConfig {
    -host : String
    -port : int
    -username : String
    -password : String
    -remoteRoot : String
    -authEnvVar : String
    ~host() : String
    ~port() : int
    ~username() : String
    ~password() : String
    ~remoteRoot() : String
    ~authEnvVar() : String
  }

  class NfsSftpFsProvider {
    -mounted : Map<String, NfsFileSystem>
    +getScheme() : String
    +newFileSystem(URI, Map) : FileSystem
  }

  class NfsSftpFsIO {
    ~{static} ensureMountRootExists(NfsSftpConfig) : void
    ~{static} listDirectory(NfsSftpConfig, String) : List<RemoteEntry>
    ~{static} readFile(NfsSftpConfig, String) : byte[]
    ~{static} writeFile(NfsSftpConfig, String, byte[]) : void
    ~{static} deleteFile(NfsSftpConfig, String) : void
    ~{static} rename(NfsSftpConfig, String, String) : void
    ~{static} createDirectory(NfsSftpConfig, String) : void
    ~{static} stat(NfsSftpConfig, String) : NfsBasicFileAttributes
  }

  class NfsBasicFileAttributes {
    -directory : boolean
    -symbolicLink : boolean
    -size : long
    -lastModifiedTime : FileTime
    +isDirectory() : boolean
    +isRegularFile() : boolean
    +size() : long
    +lastModifiedTime() : FileTime
    +lastAccessTime() : FileTime
    +creationTime() : FileTime
  }

  class NfsDirectoryStream {
    -entries : List<Path>
    -filter : Filter
    -open : boolean
    +iterator() : Iterator<Path>
    +close() : void
  }

  class NfsDirectoryIterator {
    -inner : Iterator<Path>
    -filter : Filter
    -next : Path
  }

  class NfsSyncingByteChannel {
    -fileSystem : NfsFileSystem
    -path : NfsPath
    -readable : boolean
    -writable : boolean
    -buffer : byte[]
    -size : int
    -position : long
    -dirty : boolean
    -open : boolean
    +read(ByteBuffer) : int
    +write(ByteBuffer) : int
    +position() : long
    +position(long) : SeekableByteChannel
    +size() : long
    +truncate(long) : SeekableByteChannel
    +isOpen() : boolean
    +close() : void
  }

  class SftpArchiveServer {
    -{static} DEFAULT_ARCHIVE : String
    -{static} DEFAULT_PORT : int
    -{static} DEFAULT_USERNAME : String
    +{static} main(String[]) : void
  }
}

