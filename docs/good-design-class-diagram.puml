' Inheritance (--|>)
ExtZipFsProvider --|> FileSystemProvider
ExtZipFileSystem --|> FileSystem
NfsFsProvider --|> FileSystemProvider
NfsSftpFsProvider --|> FileSystemProvider
NfsFileSystem --|> FileSystem
MainFrame --|> JFrame
ArchiveTreePanel --|> JPanel
FileContentPanel --|> JPanel
StatusBarPanel --|> JPanel
FileTreeCellRenderer --|> DefaultTreeCellRenderer
AboutDialog --|> JDialog
PropertiesDialog --|> JDialog
NfsConnectionDialog --|> JDialog

' Realization (..|>)
TarArchiveFormat ..|> ArchiveFormat
ZipArchiveFormat ..|> ArchiveFormat
GzipCompressionStrategy ..|> ICompressionStrategy
Bzip2CompressionStrategy ..|> ICompressionStrategy
XzCompressionStrategy ..|> ICompressionStrategy
LzmaCompressionStrategy ..|> ICompressionStrategy
NoCompressionStrategy ..|> ICompressionStrategy
LocalFileSystemDriver ..|> FileSystemDriver
NfsFileSystemDriver ..|> FileSystemDriver
ZipFileSystemDriver ..|> FileSystemDriver
NfsFileSystem ..|> IRemoteFileSystem
ExtZipPath ..|> Path
NfsPath ..|> Path
NfsBasicFileAttributes ..|> BasicFileAttributes
ArchiveController ..|> IArchiveController
ArchiveController ..|> INfsController
FileOperations ..|> IFileOperations
NfsFileOperations ..|> IFileOperations
FileNode ..|> Comparable

' Associations (-->)
FileSystemFactory --> FileSystemDriver : uses
FileSystemFactory ..> LocalFileSystemDriver : creates
FileSystemFactory ..> ZipFileSystemDriver : creates
FileSystemFactory ..> NfsFileSystemDriver : creates
ZipFileSystemDriver --> ExtZipFsProvider
NfsFileSystemDriver --> NfsSftpFsProvider
ExtZipFsProvider --> ExtZipFileSystem : mounts
NfsSftpFsProvider --> NfsFileSystem : mounts
NfsFsProvider --> NfsFileSystem : mounts
ExtZipFileSystem ..> ExtZipPath : wraps
NfsFileSystem --> NfsSftpConfig
NfsFileSystem --> NfsConnectionConfig : legacyConfig
ArchiveFormats --> ArchiveFormat : resolves
ArchiveFormatDetector ..> ArchiveFormatInfo : creates
ArchiveFormatInfo --> ArchiveContainerType
CompressionStrategyFactory ..> ICompressionStrategy : creates
TarArchiveFormat ..> ExtZipFsIO
ZipArchiveFormat ..> ExtZipFsIO
ExtZipFsIO ..> ICompressionStrategy : uses
NfsSftpFsIO ..> NfsSftpConfig
NfsSftpFsIO ..> NfsBasicFileAttributes : creates
NfsSyncingByteChannel --> NfsFileSystem
NfsSyncingByteChannel --> NfsPath
NfsDirectoryStream ..> NfsDirectoryIterator : creates
ArchiveModel "1" *--> "*" MountSession : manages
ArchiveModel --> FileSystemFactory : uses
ArchiveModel --> FileNode : selectedFile
MountSession --> NfsConnectionConfig : has
RemoteMountManager --> NfsConnectionConfig : manages
ArchiveController --> ArchiveModel
ArchiveController --> FileOperations : delegates
ArchiveController --> NfsFileOperations : delegates
FileOperations --> ArchiveModel
NfsFileOperations --> ArchiveModel
NfsFileOperations --> NfsConnectionConfig
NfsConnectionDialog ..> NfsConnectionConfig : creates
WeeFsApp --> ArchiveModel
WeeFsApp --> ArchiveController
WeeFsApp --> MainFrame
MainFrame --> ArchiveModel
MainFrame --> IArchiveController : uses
ArchiveTreePanel --> ArchiveModel
ArchiveTreePanel --> IArchiveController
FileContentPanel --> ArchiveModel
FileContentPanel --> IArchiveController
StatusBarPanel --> ArchiveModel
MenuBarFactory ..> IArchiveController
MenuBarFactory ..> INfsController
ToolBarFactory ..> IArchiveController
ToolBarFactory ..> INfsController
NfsIO ..> NfsConnectionConfig
