@startuml
title WeeFsApp — Good Design Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

' ═══════════════════════════════════════════════════════════════════════
'  CORE · EXTRACTOR  (format Strategy + detection)
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.core.extractor" {

  interface ArchiveFormat <<Strategy>> {
    +supports(Path) : boolean
    +extract(Path, Path) : void
    +write(Path, Path) : void
  }

  class ZipArchiveFormat {
    +supports(Path) : boolean
    +extract(Path, Path) : void
    +write(Path, Path) : void
  }

  class TarArchiveFormat {
    -compressionFactory : CompressionStrategyFactory
    +supports(Path) : boolean
    +extract(Path, Path) : void
    +write(Path, Path) : void
  }

  class ArchiveFormats {
    +{static} all() : List<ArchiveFormat>
    +{static} forPath(Path) : Optional<ArchiveFormat>
  }

  class ExtZipFsProvider {
    +getScheme() : String
    +newFileSystem(URI, Map) : FileSystem
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  CORE · EXTRACTOR · COMPRESSION  (Strategy + Factory)
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.core.extractor.compression" {

  interface ICompressionStrategy <<Strategy>> {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class CompressionStrategyFactory <<Factory>> {
    -strategies : Map<String, ICompressionStrategy>
    +register(String, ICompressionStrategy) : void
    +forExtension(String) : ICompressionStrategy
  }

  class GzipCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class Bzip2CompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class XzCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }

  class NoCompressionStrategy {
    +wrapInput(InputStream) : InputStream
    +wrapOutput(OutputStream) : OutputStream
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  CORE · FILESYSTEM  (SPI-based driver registration)
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.core.filesystem" {

  interface FileSystemDriver {
    +scheme() : String
    +open(URI, Map) : FileSystem
  }

  class FileSystemFactory {
    -drivers : Map<String, FileSystemDriver>
    +FileSystemFactory()
    +register(FileSystemDriver) : void
    +registerDriver(String, FileSystemDriver) : void
    +open(URI, Map) : FileSystem
    +supportedSchemes() : List<String>
    -registerDefaults() : void
  }

  class LocalFileSystemDriver {
    +scheme() : String
    +open(URI, Map) : FileSystem
  }

  class NfsFileSystemDriver {
    -provider : NfsSftpFsProvider
    +NfsFileSystemDriver(NfsSftpFsProvider)
    +scheme() : String
    +open(URI, Map) : FileSystem
  }

  class ZipFileSystemDriver {
    -provider : ExtZipFsProvider
    +ZipFileSystemDriver(ExtZipFsProvider)
    +scheme() : String
    +open(URI, Map) : FileSystem
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  CORE · NFS
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.core.nfs" {

  interface IRemoteFileSystem {
    +read(String) : byte[]
    +write(String, byte[]) : void
    +delete(String) : void
    +list(String) : List<NfsFileInfo>
  }

  class NfsConnectionConfig {
    -host : String
    -port : int
    -exportPath : String
    -mountPoint : String
    -readOnly : boolean
    +getHost() : String
    +getPort() : int
    +isReadOnly() : boolean
  }

  class NfsSftpFsProvider {
    -io : NfsSftpFsIO
    +getScheme() : String
    +newFileSystem(URI, Map) : FileSystem
  }

  class NfsSftpFsIO {
    -pool : SessionPool
    +get(NfsSftpConfig, Path) : InputStream
    +put(NfsSftpConfig, Path, InputStream) : void
    +delete(NfsSftpConfig, Path) : void
  }

  class NfsFileSystem {
    -provider : NfsSftpFsProvider
    -config : NfsSftpConfig
    +getPath(String, String...) : Path
    +close() : void
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  UI · MODEL  (sessions split out of god object)
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.ui.model" {

  class ArchiveModel {
    +{static} PROP_SESSION_ADDED : String
    +{static} PROP_SESSION_REMOVED : String
    +{static} PROP_ARCHIVE_PATH : String
    +{static} PROP_REMOTE_MOUNTED : String
    +{static} PROP_NFS_CONFIG : String
    -sessions : List<MountSession>
    -activeSession : MountSession
    -selectedFile : FileNode
    -remoteMounts : RemoteMountManager
    +openArchive(Path, boolean) : void
    +openMountUri(URI, boolean) : void
    +closeSession(String) : void
    +getSessions() : List<MountSession>
    +getActiveSession() : MountSession
    +setActiveSession(String) : void
    +listChildren(Path) : List<FileNode>
    +readFileBytes(Path) : byte[]
    +addPropertyChangeListener(PropertyChangeListener) : void
  }

  class MountSession {
    -id : String
    -label : String
    -fileSystem : FileSystem
    -directoryRoot : Path
    -displayPath : Path
    -readOnly : boolean
    -remoteMounted : boolean
    -nfsConfig : NfsConnectionConfig
    +getId() : String
    +isNfsMounted() : boolean
    +isRemoteMounted() : boolean
    +isSaveable() : boolean
    +getRootPath() : Path
    ~close() : void
  }

  class RemoteMountManager {
    -nfsConfig : NfsConnectionConfig
    +setNfsConfig(NfsConnectionConfig) : void
    +getNfsConfig() : NfsConnectionConfig
    +isNfsMounted() : boolean
  }

  class FileNode {
    -path : Path
    -displayName : String
    -directory : boolean
    -size : long
    +getPath() : Path
    +isDirectory() : boolean
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  UI · CONTROLLER  (clean SRP + DIP)
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.ui.controller" {

  interface IArchiveController {
    +openArchive(File) : void
    +closeSession(String) : void
    +saveSession(String) : void
    +copySelected() : void
    +cutSelected() : void
    +pasteSelected() : void
    +extractSelected(Path) : void
  }

  interface INfsController {
    +mountNfs(NfsConnectionConfig) : void
    +unmountNfs() : void
    +getNfsFileOps() : IFileOperations
  }

  interface IFileOperations <<Strategy>> {
    +createFile(Path, String) : boolean
    +createDirectory(Path) : boolean
    +delete(Path) : boolean
    +rename(Path, Path) : boolean
    +saveFile(Path, String) : boolean
    +extractTo(Path, Path) : boolean
    +copy(Path, Path) : boolean
  }

  class ArchiveController {
    -model : ArchiveModel
    -fileOps : FileOperations
    -nfsFileOps : NfsFileOperations
    -clipboard : ClipboardEntry
    -parentComponent : Component
    +setParentComponent(Component) : void
    +getModel() : ArchiveModel
    +getFileOps() : IFileOperations
    +openDirectory() : void
    +openArchive() : void
    +createArchive() : void
    +mountNfs() : void
    +closeSession(String) : void
    +closeArchive() : void
    +saveArchive() : void
    +saveSession(String) : void
    +copySelected() : void
    +cutSelected() : void
    +pasteSelected() : void
    +hasClipboard() : boolean
    +newFile() : void
    +newDirectory() : void
    +deleteSelected() : void
    +renameSelected() : void
    +extractSelected() : void
    +saveFileContent(Path, String) : void
  }

  class FileOperations {
    -model : ArchiveModel
    +createFile(Path, String) : boolean
    +createDirectory(Path) : boolean
    +delete(Path) : boolean
    +rename(Path, Path) : boolean
    +saveFile(Path, String) : boolean
    +extractTo(Path, Path) : boolean
    +copy(Path, Path) : boolean
  }

  class NfsFileOperations {
    -model : ArchiveModel
    -config : NfsConnectionConfig
    +setConfig(NfsConnectionConfig) : void
    +getConfig() : NfsConnectionConfig
    +createFile(Path, String) : boolean
    +createDirectory(Path) : boolean
    +delete(Path) : boolean
    +rename(Path, Path) : boolean
    +saveFile(Path, String) : boolean
    +extractTo(Path, Path) : boolean
    +copy(Path, Path) : boolean
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  UI · VIEW
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.ui.view" {

  class MainFrame {
    -model : ArchiveModel
    -controller : IArchiveController
    +buildUI() : void
    -handleExit() : void
  }

  class ArchiveTreePanel {
    -model : ArchiveModel
    -controller : IArchiveController
    +refresh() : void
    -confirmAndClose(String) : void
  }

  class MenuBarFactory {
    +{static} build(ArchiveModel, IArchiveController, INfsController) : JMenuBar
  }

  class ToolBarFactory {
    +{static} build(ArchiveModel, IArchiveController, INfsController) : JToolBar
  }
}

' ═══════════════════════════════════════════════════════════════════════
'  UI · APP
' ═══════════════════════════════════════════════════════════════════════
package "io.wfs.ui" {
  class WeeFsApp {
    -model : ArchiveModel
    -controller : ArchiveController
    +{static} main(String[]) : void
  }
}

' ─── Relationships ──────────────────────────────────────────────────────
ArchiveFormat <|.. ZipArchiveFormat
ArchiveFormat <|.. TarArchiveFormat

ICompressionStrategy <|.. GzipCompressionStrategy
ICompressionStrategy <|.. Bzip2CompressionStrategy
ICompressionStrategy <|.. XzCompressionStrategy
ICompressionStrategy <|.. NoCompressionStrategy

FileSystemDriver <|.. LocalFileSystemDriver
FileSystemDriver <|.. NfsFileSystemDriver
FileSystemDriver <|.. ZipFileSystemDriver

IArchiveController <|.. ArchiveController
INfsController     <|.. ArchiveController
IFileOperations    <|.. FileOperations
IFileOperations    <|.. NfsFileOperations

TarArchiveFormat --> CompressionStrategyFactory
CompressionStrategyFactory --> ICompressionStrategy
ArchiveFormats --> ArchiveFormat

FileSystemFactory --> FileSystemDriver : discovers via ServiceLoader
NfsFileSystemDriver --> NfsSftpFsProvider : injected
ZipFileSystemDriver --> ExtZipFsProvider : injected

NfsSftpFsProvider  --> NfsSftpFsIO
NfsSftpFsProvider  --> NfsFileSystem
NfsSftpFsIO       ..|> IRemoteFileSystem

ArchiveModel --> MountSession : "*"
ArchiveModel --> RemoteMountManager
ArchiveModel --> FileNode
RemoteMountManager --> FileSystemFactory
MountSession --> NfsConnectionConfig

ArchiveController --> ArchiveModel
ArchiveController --> FileOperations
ArchiveController --> NfsFileOperations
FileOperations    --> ArchiveModel
NfsFileOperations --> NfsConnectionConfig

WeeFsApp  --> ArchiveModel
WeeFsApp  --> ArchiveController
MainFrame --> ArchiveModel
MainFrame --> IArchiveController
ArchiveTreePanel --> ArchiveModel
ArchiveTreePanel --> IArchiveController
MenuBarFactory   --> IArchiveController
MenuBarFactory   --> INfsController
ToolBarFactory   --> IArchiveController
ToolBarFactory   --> INfsController

note top of ArchiveModel
  God-object fixed:
   • sessions extracted into MountSession
   • remote mount logic lives in
     RemoteMountManager
   • no embedded NfsIO static calls
end note

note top of FileSystemFactory
  Extensible design:
   • drivers stored in ConcurrentMap
   • registerDefaults() hardcodes
     built-in drivers (ZIP, NFS, file)
   • register(driver) allows runtime
     registration of custom schemes
end note

note bottom of NfsSftpFsIO
  Single provider, pooled SFTP sessions.
  Implements IRemoteFileSystem so higher
  layers depend on an abstraction (DIP).
end note

note top of MountSession
  Value object for one mount.
  Carries fileSystem + config +
  read-only / remote flags.
end note

@enduml
