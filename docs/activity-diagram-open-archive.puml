@startuml
title Open Archive / Mount Remote — URI routing in good-design

start

:User triggers open action
(File chooser, Open Directory,
 NFS dialog, or URI input);

if (Input kind?) then (local file)
  :ArchiveModel.openArchive(file, readOnly);
  :Build xzip:// URI from file path;
else if (directory) then (yes)
  :ArchiveModel.openDirectory(dir);
  :FileSystems.getDefault() used directly;
else if (NFS dialog) then (yes)
  :ArchiveModel.setNfsConfig(cfg)
  → creates NFS MountSession;
  stop
else (URI string)
  :ArchiveModel.openMountUri(uri, readOnly);
  :Parse scheme;
endif

:FileSystemFactory.open(uri, env);
note right: drivers discovered via\njava.util.ServiceLoader<FileSystemDriver>

if (scheme) then (xzip)
  :ZipFileSystemDriver.open
  (delegates to injected ExtZipFsProvider);
  :ExtZipFileSystem returned;
else if (weefs) then (yes)
  :NfsFileSystemDriver.open
  (delegates to injected NfsSftpFsProvider);
  :NfsParsedUri.parse → NfsSftpConfig;
  if (auth env var set?) then (yes)
    :NfsFileSystem returned;
  else (no)
    :throw IOException
    "auth env var not set";
    :UIUtils.showError();
    stop
  endif
else (file)
  :LocalFileSystemDriver.open;
  :FileSystems.getDefault();
endif

:Wrap in new MountSession
(displayPath, readOnly, remoteMounted flags);
:ArchiveModel.addSession(session);
:Fire PROP_SESSION_ADDED
+ PROP_ARCHIVE_PATH (+ PROP_REMOTE_MOUNTED if remote);

:ArchiveTreePanel adds new root node
for this session;

stop
@enduml
