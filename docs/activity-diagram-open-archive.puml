@startuml
title Open Archive / Mount Remote via URI

start

:User triggers open action
(file chooser, open directory, or URI input);

if (Input kind?) then (local archive file)
  :Build xzip:// URI from file path;
else if (local directory) then (yes)
  :Use default filesystem URI;
else (URI string)
  :Parse scheme from URI;
endif

:Resolve filesystem driver by URI scheme;

if (scheme?) then (xzip)
  :Extract archive to cache directory;
  :Select archive-backed virtual FileSystem;
else if (weefs) then (yes)
  if (auth env var set?) then (yes)
    :Verify remote root is reachable;
    :Select remote-backed FileSystem;
  else (no)
    :Report error; auth env var not set;
    stop
  endif
else (file)
  :Select default local FileSystem;
endif

:Wrap in new mount session
(display path, read-only flag, remote flag);
:Add session to model;
:Notify views, tree adds new session root node;

stop
@enduml
