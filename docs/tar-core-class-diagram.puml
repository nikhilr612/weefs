@startuml tar-core-class-diagram
title weefs — TAR + Core Extractor / FileSystem Module

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

' =====================================================
' External boundaries
' =====================================================
package "java.nio.file (JDK)" <<External>> {
  abstract class FileSystem
  abstract class FileSystemProvider
  interface Path
  interface "DirectoryStream<Path>" as DirectoryStream
  interface SeekableByteChannel
}
package "java.util (JDK)" <<External>> {
  interface "Iterator<Path>" as JdkIterator
}
package "java.util.zip (JDK)" <<External>> {
  class ZipInputStream
  class ZipOutputStream
  class ZipEntry
}
package "org.kamranzafar.jtar" <<External>> {
  class TarInputStream
  class TarOutputStream
  class TarEntry
}
package "io.wfs.core.extractor.compression (bridge)" <<External>> {
  interface ICompressionStrategy
  class CompressionStrategyFactory
}
package "io.wfs.util" <<External>> {
  class FileUtils
}
package "io.wfs.core.filesystem (bridge)" <<External>> {
  class FsEnvKeys
}

' =====================================================
' Archive format strategy
' =====================================================
package "io.wfs.core.extractor (formats)" {
  interface ArchiveFormat <<Strategy>> {
    +supports(archiveFile : Path) : boolean
    +extract(archiveFile : Path, targetRoot : Path) : void
    +write(sourceRoot : Path, archiveFile : Path) : void
  }

  class ZipArchiveFormat {
    +supports(archiveFile : Path) : boolean
    +extract(archiveFile : Path, targetRoot : Path) : void
    +write(sourceRoot : Path, archiveFile : Path) : void
  }

  class TarArchiveFormat {
    +supports(archiveFile : Path) : boolean
    +extract(archiveFile : Path, targetRoot : Path) : void
    +write(sourceRoot : Path, archiveFile : Path) : void
  }

  class ArchiveFormats <<Registry>> {
    -{static} FORMATS : List<ArchiveFormat>
    -ArchiveFormats()
    +{static} resolve(archiveFile : Path) : ArchiveFormat
    +{static} extractToDirectory(archiveFile : Path, target : Path) : void
    +{static} writeFromDirectory(sourceRoot : Path, archiveFile : Path) : void
  }

  class ArchiveFormatDetector <<utility>> {
    -ArchiveFormatDetector()
    ~{static} detect(archiveFile : Path) : ArchiveFormatInfo
  }

  class ArchiveFormatInfo <<value>> {
    -containerType : ArchiveContainerType
    -compressionKey : String
    ~ArchiveFormatInfo(type : ArchiveContainerType, key : String)
    ~containerType() : ArchiveContainerType
    ~compressionKey() : String
  }

  enum ArchiveContainerType {
    ZIP
    TAR
    SINGLE_FILE
  }

  ArchiveFormat <|.. ZipArchiveFormat
  ArchiveFormat <|.. TarArchiveFormat
  ArchiveFormats o--> "*" ArchiveFormat : FORMATS
  ArchiveFormatDetector ..> ArchiveFormatInfo
  ArchiveFormatInfo --> ArchiveContainerType
}

' =====================================================
' weefs:// virtual FileSystem (ExtZip*)
' =====================================================
package "io.wfs.core.extractor (fs provider)" {
  class ExtZipFileSystem {
    -provider : ExtZipFsProvider
    -archivePath : Path
    -tempRoot : Path
    -readOnly : boolean
    -open : AtomicBoolean
    -shutdownHook : Thread
    +provider() : FileSystemProvider
    +close() : void
    +isOpen() : boolean
    +isReadOnly() : boolean
    +getSeparator() : String
    +getRootDirectories() : Iterable<Path>
    +getFileStores() : Iterable<FileStore>
    +supportedFileAttributeViews() : Set<String>
    +getPath(first : String, more : String[]) : Path
    +getPathMatcher(syntaxAndPattern : String) : PathMatcher
    +getUserPrincipalLookupService() : UserPrincipalLookupService
    +newWatchService() : WatchService
    #installShutdownHook() : void
    #getArchivePath() : Path
    #getTempRoot() : Path
    #wrap(p : Path) : ExtZipPath
    #ensureWritable() : void
    #ensureWritableFor(options : Set<? extends OpenOption>) : void
  }

  class ExtZipFsProvider {
    -mounted : Map<Path, ExtZipFileSystem>
    +getScheme() : String
    +newFileSystem(uri : URI, env : Map<String, ?>) : FileSystem
    +getFileSystem(uri : URI) : FileSystem
    +getPath(uri : URI) : Path
    +newByteChannel(p : Path, opts : Set<? extends OpenOption>, attrs : FileAttribute<?>[]) : SeekableByteChannel
    +newDirectoryStream(dir : Path, f : Filter<? super Path>) : DirectoryStream<Path>
    +createDirectory(dir : Path, attrs : FileAttribute<?>[]) : void
    +delete(path : Path) : void
    +copy(src : Path, tgt : Path, opts : CopyOption[]) : void
    +move(src : Path, tgt : Path, opts : CopyOption[]) : void
    +isSameFile(a : Path, b : Path) : boolean
    +isHidden(path : Path) : boolean
    +getFileStore(path : Path) : FileStore
    +checkAccess(path : Path, modes : AccessMode[]) : void
    +readAttributes(path : Path, type : Class<A>, opts : LinkOption[]) : A
    +readAttributes(path : Path, attrs : String, opts : LinkOption[]) : Map<String, Object>
    +setAttribute(path : Path, attr : String, value : Object, opts : LinkOption[]) : void
    #resolveArchivePath(raw : String, env : Map<String, ?>) : Path
    #toKey(archivePath : Path) : Path
    #requireExtPath(p : Path) : ExtZipPath
    #unregister(fs : ExtZipFileSystem) : void
  }

  class ExtZipPath {
    -fileSystem : ExtZipFileSystem
    -delegate : Path
    +getFileSystem() : ExtZipFileSystem
    +isAbsolute() : boolean
    +getRoot() : Path
    +getFileName() : Path
    +getParent() : Path
    +getNameCount() : int
    +getName(index : int) : Path
    +subpath(begin : int, end : int) : Path
    +resolve(other : Path) : Path
    +relativize(other : Path) : Path
    +toUri() : URI
    +toAbsolutePath() : Path
    +toRealPath(opts : LinkOption[]) : Path
    +toFile() : File
    +iterator() : Iterator<Path>
    +compareTo(other : Path) : int
    #getExtZipFileSystem() : ExtZipFileSystem
    #getDelegate() : Path
  }

  class ExtZipDirectoryStream {
    -delegate : DirectoryStream<Path>
    -fileSystem : ExtZipFileSystem
    -filter : Filter<? super Path>
    +iterator() : Iterator<Path>
    +close() : void
  }

  class ExtZipDirectoryIterator {
    -delegate : Iterator<Path>
    -fileSystem : ExtZipFileSystem
    -filter : Filter<? super Path>
    -next : Path
    -prepared : boolean
    +hasNext() : boolean
    +next() : Path
  }

  class ExtZipPathIterator {
    -fileSystem : ExtZipFileSystem
    -delegate : Iterator<Path>
    +hasNext() : boolean
    +next() : Path
  }

  class ExtZipParsedUri <<value>> {
    -archivePart : String
    -entryPart : String
    +archivePart() : String
    +entryPart() : String
    +{static} parse(uri : URI, scheme : String) : ExtZipParsedUri
  }

  class ExtZipFsIO <<utility>> {
    +{static} extractArchiveToDirectory(archive : Path, target : Path) : void
    +{static} extractZipToDirectory(archive : Path, target : Path) : void
    +{static} extractTarToDirectory(archive : Path, target : Path, compressionKey : String) : void
    +{static} writeDirectoryToArchive(src : Path, archive : Path) : void
    +{static} writeDirectoryToZip(src : Path, archive : Path) : void
    +{static} writeDirectoryToTar(src : Path, archive : Path, compressionKey : String) : void
    +{static} extractSingleFileArchiveToDirectory(archive : Path, target : Path, key : String) : void
    +{static} writeDirectoryToSingleFileArchive(src : Path, archive : Path, key : String) : void
    +{static} deleteRecursively(root : Path) : void
  }
}

' =====================================================
' Inheritance / implementation
' =====================================================
ExtZipFileSystem --|> FileSystem
ExtZipFsProvider --|> FileSystemProvider
ExtZipPath ..|> Path
ExtZipDirectoryStream ..|> DirectoryStream
ExtZipDirectoryIterator ..|> JdkIterator
ExtZipPathIterator ..|> JdkIterator

' =====================================================
' Compositions / dependencies
' =====================================================
ExtZipFileSystem --> "1" ExtZipFsProvider
ExtZipFileSystem *--> "1" Path : archivePath
ExtZipFileSystem *--> "1" Path : tempRoot
ExtZipFsProvider o--> "*" ExtZipFileSystem : mounted
ExtZipFsProvider ..> FsEnvKeys
ExtZipFsProvider ..> ExtZipPath
ExtZipFsProvider ..> ExtZipFileSystem
ExtZipPath --> "1" ExtZipFileSystem
ExtZipPath --> "1" Path : delegate
ExtZipDirectoryStream --> ExtZipFileSystem
ExtZipDirectoryStream --> DirectoryStream : delegate
ExtZipDirectoryIterator --> ExtZipFileSystem
ExtZipDirectoryIterator --> JdkIterator : delegate
ExtZipPathIterator --> ExtZipFileSystem

' Format resolution
ArchiveFormats ..> ArchiveFormatDetector
ArchiveFormats ..> ArchiveFormat
ExtZipFileSystem ..> ArchiveFormats
ExtZipFileSystem ..> ArchiveFormatInfo
ExtZipFileSystem ..> ExtZipFsIO
ExtZipFsIO ..> CompressionStrategyFactory
ExtZipFsIO ..> ICompressionStrategy
ExtZipFsIO ..> ZipInputStream
ExtZipFsIO ..> ZipOutputStream
ExtZipFsIO ..> ZipEntry
ExtZipFsIO ..> TarInputStream
ExtZipFsIO ..> TarOutputStream
ExtZipFsIO ..> TarEntry
ExtZipFsIO ..> FileUtils
TarArchiveFormat ..> ExtZipFsIO
ZipArchiveFormat ..> ExtZipFsIO
ExtZipParsedUri ..> ExtZipFsProvider : <<used by>>

note bottom of ArchiveFormat
  Strategy: resolve() picks the right
  format; each delegates actual byte
  work to ExtZipFsIO + compression
  strategies.
end note

' --- supplemental relationships ---
ArchiveFormatDetector --> ArchiveContainerType

' --- supplemental relationships ---
FileSystem <|-- ExtZipFileSystem
FileSystemProvider <|-- ExtZipFsProvider
Path <|.. ExtZipPath
ArchiveFormatDetector --> ArchiveFormats
@enduml
