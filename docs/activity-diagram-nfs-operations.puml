@startuml
title NFS / SFTP File Operations (extract · copy · delete · paste)

start

:User selects node(s) in the tree
and triggers an operation;

:ArchiveController dispatches
extractSelected or deleteSelected or
copySelected or cutSelected or pasteSelected;

if (action is copy or cut?) then (yes)
  :record selected FileNode +
  sourceSessionId in ClipboardEntry;
  stop
endif

:Resolve active session's FileOperations:
getFileOps() →
  if session is NFS → NfsFileOperations(config)
  else → FileOperations;
note right
  Both implement IFileOperations.
  ArchiveController depends on the
  interface, not the concrete class (DIP).
end note

if (operation) then (extract)
  :IFileOperations.extractTo(src, dest);
  if (source is NFS?) then (yes)
    :NfsSftpFsProvider.get(config, src)
    streams bytes via
    NfsSyncingByteChannel;
    :write to local dest via FileUtils;
  else (no)
    :Files.copy / walk + copy
    across FileSystem boundaries;
  endif

else if (delete) then (yes)
  :IFileOperations.delete(path);
  if (directory?) then (yes)
    :FileUtils.deleteRecursively(path);
  endif

else if (paste) then (yes)
  :resolve ClipboardEntry.sourceSessionId;
  :read bytes via that session;
  :write bytes into active session's
  target directory;
  if (was cut?) then (yes)
    :delete source;
  endif

else (rename)
  :IFileOperations.rename(path, newName);
endif

if (success?) then (yes)
  :ArchiveModel.fireTreeRefresh();
  :ArchiveTreePanel repaints affected
  session root(s);
else (no)
  :UIUtils.showError(parent, msg, ex);
endif

stop
@enduml
