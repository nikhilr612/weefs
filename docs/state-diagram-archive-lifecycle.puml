@startuml
title MountSession Lifecycle

[*] --> NoSessions : app starts

state NoSessions {
  NoSessions : do / await open action
}

NoSessions  -right-> HasSessions : session opened\n(archive, directory, or remote mount)
HasSessions -left->  NoSessions  : last session closed
HasSessions -right-> HasSessions : another session opened\nor active session switched
HasSessions -down->  [*]         : app exits\n(open archive sessions flushed)
NoSessions  -down->  [*]         : app exits

state HasSessions {
  [*] --> Browsing

  state Browsing {
    Browsing : do / display session tree;\nrespond to file selection
  }

  state Operating {
    Operating : entry / start background task
    Operating : do / execute file operation\n(extract, delete, copy, paste, rename)
    Operating : exit / report result to user
  }

  state Saving {
    Saving : do / close session — ExtZipFileSystem\nwrites temp directory to archive file on close;\nthen archive is reopened as a new session
  }

  Browsing  --> Operating : file operation triggered
  Operating --> Browsing  : operation complete or failed
  Browsing  --> Saving    : save archive requested\n[saveable session: writable, local archive]
  Saving    --> Browsing  : archive reopened
}

note right of HasSessions
  Multiple sessions may be open simultaneously.
  Opening another archive adds a new session
  rather than replacing the current one.
  Archive sessions are flushed on close;
  directory and remote mounts are write-through.
end note
@enduml
