@startuml
title MountSession Lifecycle (good-design, multi-session)

[*] --> AppIdle : App starts

state AppIdle {
  [*] --> NoSessions
  NoSessions : sessions.isEmpty() == true\nPROP_OPEN = false
}

state HasSessions {
  [*] --> Active
  state Active {
    Browsing   : list children of activeSession.rootPath
    Extracting : IFileOperations.extractTo(src, dest)
    Saving     : closeSession + reopen (ZIP flush)

    Browsing   --> Extracting : extractSelected()
    Extracting --> Browsing   : success / error
    Browsing   --> Saving     : saveSession(id)
    Saving     --> Browsing   : reopened
  }

  Active : activeSession != null\nPROP_ARCHIVE_PATH fired on switch
}

NoSessions  --> HasSessions  : openArchive(File) /\n openMountUri(URI) /\n mountNfs(config)\nPROP_SESSION_ADDED
HasSessions --> HasSessions  : setActiveSession(id)\nPROP_ARCHIVE_PATH
HasSessions --> HasSessions  : openArchive() ... (adds session)\nPROP_SESSION_ADDED
HasSessions --> HasSessions  : closeSession(id)\nPROP_SESSION_REMOVED\n[sessions still non-empty]
HasSessions --> NoSessions   : closeSession(id)\nPROP_SESSION_REMOVED\n[last session removed]\nPROP_OPEN = false

AppIdle --> [*] : App exits\n(closeArchive flushes all)

note right of HasSessions
  ArchiveModel holds a List<MountSession>.
  Opening another archive / directory / remote
  ADDS a new session rather than replacing.
  Each session owns its own FileSystem.
end note

note left of Active
  Writable ZIP sessions are flushed
  on close (isSaveable() == true).
  Directory, NFS and weefs:// mounts
  are write-through.
end note
@enduml
