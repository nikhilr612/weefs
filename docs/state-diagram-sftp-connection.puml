@startuml
title SFTP Filesystem & Byte Channel States\n(NfsSftpFsProvider / NfsSyncingByteChannel)

[*] --> Unbound : provider created

state Unbound {
  Unbound : do / await mount request;\nno connection established
}

state Error {
  Error : entry / record failure cause
  Error : do / await retry or dismiss
}

Unbound -down->  Mounted : newFileSystem()\n[auth env var present;\nremote root reachable]
Unbound -down->  Error   : newFileSystem()\n[auth env var missing\nor connection refused]
Mounted -up->    Unbound : close()
Error   -left->  Unbound : retry / dismiss
Error   -down->  [*]     : fatal error / app exit

state Mounted {
  Mounted : entry / auth env var resolved;\nremote root verified via one-off SFTP check
  Mounted : do / accept file operations;\neach opens a short-lived SFTP session,\ncompletes the work, then disconnects
  Mounted : exit / unregister from provider map;\nremove JVM shutdown hook

  state "Byte Channel (one per open file)" as BC {
    [*] --> Open
    Open : entry / buffer initialized from remote\ncontent (existing files), or empty for\nnew or truncated files
    Open : do / reads and writes update the\nbuffer in memory; position tracked
    Open --> Flushing : close() [dirty]
    Open --> [*]      : close() [clean]
    Flushing : do / write buffer to remote\nvia a new short-lived SFTP session
    Flushing --> [*]  : flush complete
  }
}

@enduml
