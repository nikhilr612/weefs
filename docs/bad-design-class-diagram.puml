' ─────────────────────────────────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────────────────────────────────

' extractor - archive formats
TarArchiveFormat ..|> ArchiveFormat
ZipArchiveFormat ..|> ArchiveFormat
ArchiveFormats --> ArchiveFormat : resolves >
ArchiveFormatDetector ..> ArchiveFormatInfo : creates >
ArchiveFormatInfo --> ArchiveContainerType
TarArchiveFormat ..> ExtZipFsIO : delegates >
ZipArchiveFormat ..> ExtZipFsIO : delegates >

' extractor - filesystem
ExtZipFsProvider ..> ExtZipFileSystem : creates >
ExtZipFsProvider ..> ExtZipParsedUri : parses >
ExtZipFileSystem --> ExtZipFsProvider
ExtZipPath --> ExtZipFileSystem
ExtZipDirectoryStream --> ExtZipDirectoryIterator

' compression
GzipCompressionStrategy ..|> ICompressionStrategy
Bzip2CompressionStrategy ..|> ICompressionStrategy
LzmaCompressionStrategy ..|> ICompressionStrategy
XzCompressionStrategy ..|> ICompressionStrategy
NoCompressionStrategy ..|> ICompressionStrategy
CompressionStrategyFactory ..> ICompressionStrategy : produces >
ExtZipFsIO ..> ICompressionStrategy : uses >

' filesystem drivers
LocalFileSystemDriver ..|> FileSystemDriver
NfsFileSystemDriver ..|> FileSystemDriver
ZipFileSystemDriver ..|> FileSystemDriver
FileSystemFactory --> FileSystemDriver : dispatches >
ZipFileSystemDriver --> ExtZipFsProvider : instantiates >
NfsFileSystemDriver --> NfsSftpFsProvider : instantiates >

' nfs internals
NfsSftpFsIO ..> NfsSftpConfig : uses per-call >
NfsFileSystem --> NfsSftpFsProvider
NfsFileSystem --> NfsSftpConfig
NfsFileSystem --> NfsConnectionConfig
NfsSftpFsProvider ..> NfsFileSystem : creates >
NfsSftpFsProvider ..> NfsSftpConfig : parses to >
NfsFsProvider ..> NfsConnectionConfig : uses >
NfsPath --> NfsFileSystem
NfsDirectoryStream --> NfsDirectoryIterator
NfsFsProvider ..> NfsPath : creates >
NfsSftpFsProvider ..> NfsPath : creates >
NfsIO ..> NfsConnectionConfig : uses >
NfsIO ..> NfsFileInfo : returns >

' controller
ArchiveController ..|> IArchiveController
ArchiveController ..|> INfsController
FileOperations ..|> IFileOperations
NfsFileOperations ..|> IFileOperations
ArchiveController --> ArchiveModel
ArchiveController --> FileOperations
ArchiveController --> NfsFileOperations
ArchiveController --> NfsConnectionConfig : duplicates >
FileOperations --> ArchiveModel
NfsFileOperations --> ArchiveModel
