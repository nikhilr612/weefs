@startuml bad-design-class-diagram
title WeeFsApp — Bad-Design Class Diagram (v2)

skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam linetype ortho
hide empty members

' ══════════════════════════════════════════════════════
'  CORE — extractor
' ══════════════════════════════════════════════════════
package "io.wfs.core.extractor" {
    interface IArchiveExtractor
    class ArchiveExtractor implements IArchiveExtractor
    class ExtZipFsProvider
    class ExtZipFsIO
    class ExtZipFileSystem
    class ExtZipPath
    class ExtZipDirectoryStream
    class ArchiveFormatDetector
    class ArchiveFormatInfo
    enum ArchiveContainerType

    package "compression" {
        interface ICompressionStrategy
        class CompressionStrategyFactory
        class GzipCompressionStrategy implements ICompressionStrategy
        class Bzip2CompressionStrategy implements ICompressionStrategy
        class XzCompressionStrategy implements ICompressionStrategy
        class LzmaCompressionStrategy implements ICompressionStrategy
        class NoCompressionStrategy implements ICompressionStrategy
    }
}

' ══════════════════════════════════════════════════════
'  CORE — filesystem (NEW in v2)
' ══════════════════════════════════════════════════════
package "io.wfs.core.filesystem" {
    interface FileSystemDriver <<BAD: DIP violation in impls>>
    class FileSystemFactory <<BAD: OCP — hardcodes 3 drivers>>
    class LocalFileSystemDriver implements FileSystemDriver
    class NfsFileSystemDriver <<BAD: instantiates NfsSftpFsProvider directly>> implements FileSystemDriver
    class ZipFileSystemDriver <<BAD: instantiates ExtZipFsProvider directly>> implements FileSystemDriver
}

' ══════════════════════════════════════════════════════
'  CORE — NFS
' ══════════════════════════════════════════════════════
package "io.wfs.core.nfs" {
    class NfsFsProvider
    class NfsIO
    class NfsConnectionConfig
    class NfsFileInfo

    class NfsSftpFsProvider <<BAD: no connection pooling>>
    class NfsSftpFsIO <<BAD: new session per op — no pooling>>
    class NfsSftpConfig
    class NfsParsedUri
    class NfsFileSystem <<BAD: dual-constructor; fragile option matching>>
    class NfsPath <<BAD: hashCode mixes virtualPath/delegate>>
    class NfsSyncingByteChannel <<BAD: position was int (fixed); still buffer-only>>
    class NfsBasicFileAttributes
    class NfsDirectoryStream
    class NfsDirectoryIterator
    class NfsPathIterator
}

' ══════════════════════════════════════════════════════
'  UI — Model
' ══════════════════════════════════════════════════════
package "io.wfs.ui.model" {
    class ArchiveModel <<BAD: god model — NFS+archive+UI state mixed>>
    class FileNode
}

' ══════════════════════════════════════════════════════
'  UI — Controller
' ══════════════════════════════════════════════════════
package "io.wfs.ui.controller" {
    interface IArchiveController
    interface INfsController <<BAD: still returns NfsFileOperations (concrete)>>
    interface IFileOperations
    class ArchiveController <<BAD: currentNfsConfig duplicates model state>>
    class FileOperations implements IFileOperations
    class NfsFileOperations <<BAD: showError(null) parent>> implements IFileOperations
}

' ══════════════════════════════════════════════════════
'  UI — View
' ══════════════════════════════════════════════════════
package "io.wfs.ui.view" {
    class MainFrame
    class MenuBarFactory <<BAD: was casting without guard (fixed)>>
    class ToolBarFactory
}

' ══════════════════════════════════════════════════════
'  UI — App
' ══════════════════════════════════════════════════════
package "io.wfs.ui" {
    class WeeFsApp <<Singleton — not injected>>
}

